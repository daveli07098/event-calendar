generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id             String           @id @default(cuid())
  name           String?
  email          String?          @unique
  emailVerified  DateTime?
  image          String?
  password       String?          // hashed — null for OAuth-only users
  themeSettings  Json?            // persisted Theme object { mode, accent, radius, density, font }
  aiQuotaDate    String?          // "YYYY-MM-DD" day key for AI rate limiting
  aiQuotaCount   Int              @default(0) // AI scrape calls used on aiQuotaDate
  accounts       Account[]
  sessions       Session[]
  calendars      Calendar[]
  calendarMemberships CalendarMember[]
  eventBookmarks EventBookmark[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Calendar {
  id               String           @id @default(cuid())
  userId           String           // owner
  name             String
  color            String           @default("#4285f4")
  isDefault        Boolean          @default(false)
  isVisible        Boolean          @default(true)
  googleCalendarId String?
  // Sharing
  shareToken       String?          @unique  // random token for invite URL; null = not shared
  shareMode        String?          // "collaborative" | "broadcast" | null
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  events  Event[]
  members CalendarMember[]

  @@index([userId])
}

// Tracks users who have joined a shared calendar
model CalendarMember {
  id         String   @id @default(cuid())
  calendarId String
  userId     String
  role       String   // "editor" | "viewer"
  joinedAt   DateTime @default(now())

  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([calendarId, userId])
  @@index([userId])
}

model Event {
  id             String   @id @default(cuid())
  calendarId     String
  title          String
  description    String?  @db.Text
  location       String?
  startTime      DateTime
  endTime        DateTime
  allDay         Boolean  @default(false)
  recurrenceRule String?
  googleEventId  String?
  category       String?  // e.g. "concert", "exhibition", "theatre", "sports", "festival", "anime", "popup", "comedy", "film", "food", "other"
  artist         String?  // main performer/artist/group (e.g. "Bruno Mars") — extracted from ticket pages
  referenceUrl   String?  // additional info/reference URL (e.g. per-station ticketing page) — preferred source for Sync updates
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  calendar  Calendar        @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  bookmarks EventBookmark[]

  @@index([calendarId])
  @@index([startTime, endTime])
}

// Per-user event bookmarks. A join table (not a flag on Event) because
// calendars are shared — one member bookmarking an event must not
// bookmark it for every other member.
model EventBookmark {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
}

// Community venue directory — referenced when importing ticket events
model EventVenue {
  id        String   @id @default(cuid())
  name      String                      // primary/official name
  aliases   String[] @default([])       // other names used for the same venue
  address   String?                     // street address
  city      String   @default("Hong Kong")
  country   String   @default("HK")
  tags      String[] @default([])       // e.g. ["arena", "theatre", "concert-hall"]
  imageUrls String[] @default([])       // uploaded venue / seating-view images (Vercel Blob URLs)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// Singleton cache of AI-fetched World Cup scores/standings. Scores are global
// facts, so a single row (id = "global") is shared by all users — one refresh
// serves everyone and survives reloads. `data` holds the JSON snapshot:
//   { groups: { [letter]: { standings: TeamStanding[], matches: MatchScore[] } }, asOf }
model WorldCupScores {
  id        String   @id @default("global")
  data      Json
  provider  String?
  fetchedAt DateTime @updatedAt
}

// Per-model daily request counter for the shared Gemini free-tier pool (RPD).
// Google resets daily quotas at midnight Pacific time, so `dayKey` is the
// "YYYY-MM-DD" date in America/Los_Angeles. One global row per model — the
// free-tier quota is per API key/project, not per user.
model AiModelUsage {
  model     String   @id
  dayKey    String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Cache of AI scrape extractions keyed by sha256(prompt version + url + page
// text). Sync re-scrapes ticket pages on every check; when the page content is
// unchanged the prompt would be identical, so the previous AI result is reused
// at ZERO Gemini requests (the free tier's binding limit is requests/day).
// Any page-content change or prompt bump produces a new hash → fresh AI call.
model AiScrapeCache {
  hash      String   @id
  url       String
  result    Json
  provider  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}
